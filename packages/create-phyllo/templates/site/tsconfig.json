{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "moduleDetection": "force",

    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun", "mdx", "phyllo/client"],
    "allowImportingTsExtensions": true,

    "noEmit": true,

    "verbatimModuleSyntax": true,

    "strict": true,

    "skipLibCheck": true
  },
  "include": [
    "phyllo.config.ts",
    "content",
    "themes",
    "mdx-jsx.d.ts",
    ".phyllo/*.d.ts"
  ]
}
