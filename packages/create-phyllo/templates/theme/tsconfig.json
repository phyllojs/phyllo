{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "moduleDetection": "force",

    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun", "phyllo/client"],
    "allowImportingTsExtensions": true,

    "noEmit": true,

    "verbatimModuleSyntax": true,

    "strict": true,

    "skipLibCheck": true
  },
  "include": ["src"]
}
