{
  "private": true,
  "description": "A Bun-only framework for building documentation sites and blogs with Markdown and MDX.",
  "homepage": "https://github.com/xueelf/phyllo#readme",
  "bugs": {
    "url": "https://github.com/xueelf/phyllo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xueelf/phyllo.git"
  },
  "license": "MIT",
  "author": "Yuki <admin@yuki.sh>",
  "type": "module",
  "workspaces": [
    "docs",
    "packages/*",
    "themes/*"
  ],
  "scripts": {
    "format": "eslint --fix --fix-type layout && prettier \"**/*.{css,json,md,ts,tsx,yaml,yml}\" \"!AGENTS.md\" --write --experimental-cli",
    "format:check": "prettier \"**/*.{css,json,md,ts,tsx,yaml,yml}\" \"!AGENTS.md\" --check --experimental-cli",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix --cache",
    "prepare": "husky",
    "test": "bun test packages themes",
    "typecheck": "tsc --noEmit && bun run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-sort": "^1.1.0",
    "typescript-eslint": "^8.67.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": ">=1.4.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.0",
      "onFail": "warn"
    }
  }
}
