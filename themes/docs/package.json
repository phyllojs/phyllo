  "description": "A documentation theme for Phyllo.",
  "keywords": [
    "phyllo",
    "phyllo-theme",
    "theme",
    "docs",
    "documentation",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xueelf/phyllo.git",
